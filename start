#!/usr/bin/env bash
# Run the gmg Docker image using settings from .env (see .env.example).
set -euo pipefail
cd "$(dirname "$0")"

if [ ! -f .env ]; then
  echo "Create .env first (cp .env.example .env) and set GMG_GRILL_HOST." >&2
  exit 1
fi
set -a; . ./.env; set +a

if [ -z "${GMG_GRILL_HOST:-}" ]; then
  echo "GMG_GRILL_HOST must be set to the grill's IP address (or the address of your emulator)." >&2
  exit 1
fi

# PORT and GMG_DB_PATH are fixed inside the container (-e overrides --env-file),
# so a .env written for ./bin/gmg works here too.
exec docker run -it --rm --env-file .env -e PORT=80 -e GMG_DB_PATH=/data -p "${GMG_EXTERNAL_PORT:-80}:80" -v gmg-data:/data gmg
