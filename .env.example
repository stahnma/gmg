# gmg settings. Copy to .env and edit:  cp .env.example .env
#
# ./bin/gmg reads .env from the working directory (or the file given with
# --env-file). Environment variables override values in the file.
# ./start passes the same file to the Docker image.

# Grill IP address. Leave unset (or a broadcast address containing 255) to
# discover the grill on the local network.
GMG_GRILL_HOST=192.168.1.100

# HTTP port for the web UI and API (default: 3001).
# Ignored by ./start: the container always listens on 80; see GMG_EXTERNAL_PORT.
# PORT=3001

# Directory for the history database, grill_data.db (default: data).
# Ignored by ./start: the container uses the gmg-data volume.
# GMG_DB_PATH=data

# Database size limit; the oldest 10% of rows are pruned when exceeded (default: 50).
# GMG_DB_MAX_SIZE_MB=50

# Target temperatures accepted, °F (defaults shown). Green Mountain grills run
# from 150 to 550 °F; lower the maximum for a model with a smaller range.
# GMG_GRILL_TEMP_MIN=150
# GMG_GRILL_TEMP_MAX=550
# GMG_FOOD_TEMP_MIN=0
# GMG_FOOD_TEMP_MAX=300

# Play a sound in the browser when an alert fires (default: false).
# No sound files are included; add them to web/public/alerts/ first (see README).
# GMG_ALERTS_AUDIO_ENABLED=true

# Alert when the grill stops answering for this many seconds while it is on
# or in fan mode (default: 60; 0 turns the alert off).
# GMG_ALERTS_UNREACHABLE_SECONDS=60

# Alert when the grill, after reaching its target, stays this many degrees
# below it for this many minutes (fire out, pellets jammed). Defaults shown;
# 0 degrees turns the alert off.
# GMG_ALERTS_TEMPDROP_DEGREES=50
# GMG_ALERTS_TEMPDROP_MINUTES=5

# Alert when the grill hasn't warmed by this many degrees within this many
# minutes of being turned on (failed igniter, full fire pot). Defaults shown;
# 0 degrees turns the alert off.
# GMG_ALERTS_IGNITION_DEGREES=30
# GMG_ALERTS_IGNITION_MINUTES=15

# Slack alerts are sent only when a webhook URL is set.
# GMG_ALERTS_SLACK_WEBHOOKURL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# GMG_ALERTS_SLACK_CHANNEL=#alerts
# GMG_ALERTS_SLACK_USERNAME=grill-bot

# Grill communication (defaults shown).
# GMG_GRILL_PORT=8080
# GMG_GRILL_TRIES=5
# GMG_GRILL_RETRYMS=2000
# GMG_STATUS_POLLING_INTERVAL=5000

# Other origins allowed to call the API from a browser, comma separated
# (default: none; same-origin requests always work). "*" allows any site,
# which lets any web page you open control the grill.
# GMG_CORS_ORIGINS=https://grill.example.com

# debug, info, warn or error (default: info).
# GMG_LOG_LEVEL=info

# ./start only: host port mapped to the container (default: 80).
# GMG_EXTERNAL_PORT=80
